generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  password         String?
  phonenumber      String?
  address          String?
  role             Role        @default(USER)
  isVerified       Boolean     @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  city             String?
  district         String?
  firstName        String?
  khoroo           String?
  lastName         String?
  notes            String?
  Order            Order[]
  orderedProducts  OrderItem[]

  reviews Review[]
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String        @unique
  orderId   String        @unique
  amount    Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  qrText    String?
  status    PaymentStatus @default(PENDING)
  qrImage   String?

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Product {
  id          String      @id @default(uuid())
  productName String
  price       Float
  image       String
  address     String?
  ingredients String
  categoryId  String?
  createdAt   DateTime    @default(now())
  extraImages String[]    @default([])
  updatedAt   DateTime    @default(now()) @updatedAt
  video       String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  sizes       ProductSize[]
  OrderItem   OrderItem[]
  isFeatured  Boolean     @default(false)
  salesCount  Int         @default(0)
  oldPrice    Float?
  discount    Int?        @default(0)

  reviews     Review[]
  avgRating   Float    @default(0)
  reviewCount Int      @default(0)

  /// Product facts the product page and the chat assistant both read (edited in the admin).
  /// Null/empty means "not published yet": the assistant then says so instead of guessing.
  volume         String?
  howToUse       String?
  ingredientList String?
  safetyNotes    String?
  faq            Json    @default("[]")

  @@index([categoryId])
  @@index([createdAt])
  @@index([salesCount])
}

model ProductSize {
  id        String @id @default(uuid())
  productId String
  label     String
  stock     Int?
  /// Own price for this size; null = the product's price.
  price     Float?
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Category {
  id           String @id @default(uuid())
  categoryName String

  parentId String? // 👈 allow category to have parent
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products Product[] // product can belong to any category level

  @@index([parentId])
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  idempotencyKey String?       @unique
  userId         String
  totalPrice     Float
  deliveryFee    Float         @default(0)
  deliveryZone   String?
  status         OrderStatus
  paymentMethod  PaymentMethod

  firstName String?
  lastName  String?
  phone     String?
  city      String?
  district  String?
  khoroo    String?
  address   String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User        @relation(fields: [userId], references: [id])
  orderItems     OrderItem[]

  lemonPayments LemonPayment[]

  @@index([userId, status])
  @@index([status])
}

model OrderItem {
  id       String    @id @default(uuid())
  productId String
  quantity Int
  size     String?
  /// Price of one unit when the order was placed (the size's price). Null on orders from before 2026-10-19.
  unitPrice Float?
  orderId  String
  userId   String?
  product  Product @relation(fields: [productId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id])
  User     User?   @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([userId])
  @@index([productId, orderId])
}

model LemonPayment {
  id           String   @id @default(uuid())
  orderId      String   @unique
  checkoutId   String?
  lemonOrderId String?  @unique
  status       String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  amount       Float?
  currency     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  checkoutUrl  String? // ✅ add this

  order Order @relation(fields: [orderId], references: [id])
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  userId           String
  rating           Int
  comment          String
  verifiedPurchase Boolean  @default(false)
  images           String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // 1 review per user per product
  @@index([productId])
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
}

enum OrderStatus {
  PENDING
  WAITING_PAYMENT
  COD_PENDING
  PAID
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK
  QPAY
  LEMON
}

model ChatSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(true)
  metaOutbound      Boolean  @default(false)
  greetingMn        String   @default("Сайн байна уу! Lorentz-ийн бүтээгдэхүүн, хүргэлт, захиалгын талаар асуугаарай.")
  greetingEn        String   @default("Hello! Ask about Lorentz products, delivery or your order.")
  handoffMn         String   @default("Таны хүсэлтийг ажилтанд хадгаллаа. Нэр, холбогдох утсаа үлдээнэ үү.")
  handoffEn         String   @default("Your request has been saved for our team. Please leave your name and phone number.")
  lowStockThreshold Int      @default(5)
  showExactStock    Boolean  @default(false)
  extraKnowledgeMn  String   @default("")
  extraKnowledgeEn  String   @default("")
  /// The assistant may create bank-transfer orders in the chat after an explicit confirmation.
  chatOrdersEnabled Boolean  @default(true)
  /// After a staff reply, the assistant resumes on its own once this many hours pass (0 = never).
  handoverAutoResumeHours Int @default(24)
  /// Model used for understanding and writing replies; "" = the deployment default.
  aiModel           String   @default("")
  /// Estimated daily spend (USD) above which the assistant answers from rules only.
  aiDailyBudgetUsd  Float    @default(5)
  updatedAt         DateTime @updatedAt
}

model ChatConversation {
  id             String   @id @default(uuid())
  tokenHash      String
  channel        String   @default("website")
  externalId     String?
  locale         String   @default("mn")
  paused         Boolean  @default(false)
  needsHuman     Boolean  @default(false)
  unread         Int      @default(0)
  state          Json     @default("{}")
  leaseUntil     DateTime?
  leaseOwner     String?
  /// Who the customer is, once they said so (also kept in `state` for the engine).
  customerName   String?
  customerPhone  String?
  /// Staff-only notes shown in the admin inbox.
  notes          String   @default("")
  /// Why the assistant asked for a person, and when; cleared when staff hand the chat back.
  handoffReason  String?
  handoffAt      DateTime?
  /// When a person last replied from the admin, and when staff last handed the chat back to the assistant.
  lastHumanAt    DateTime?
  botReleasedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       ChatMessage[]
  leads          ChatLead[]
  events         ChatWebhookEvent[]

  @@unique([channel, externalId])
  @@index([updatedAt])
  @@index([needsHuman, updatedAt])
  @@index([customerPhone])
}

model ChatMessage {
  id              String   @id @default(uuid())
  conversationId  String
  role            String
  text            String
  clientMessageId String?
  metadata        Json     @default("{}")
  deliveryStatus  String   @default("local")
  createdAt       DateTime @default(now())
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
}

model ChatLead {
  id             String   @id @default(uuid())
  conversationId String
  name           String?
  phone          String?
  question       String
  status         String   @default("new")
  /// Why staff were asked (customer_request, complaint, medical, payment_claim, unanswered, order_problem, ai_error).
  reason         String   @default("customer_request")
  /// What the conversation had established, so staff can act without reading the whole chat.
  context        String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([conversationId])
}

/// Shop-level questions and answers the owner maintains in the admin; the assistant and the FAQ page read them.
model ChatFaq {
  id         String   @id @default(uuid())
  question   String
  answer     String
  questionEn String   @default("")
  answerEn   String   @default("")
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled, sortOrder])
}

/// Daily model usage per environment, model and caller, with an estimated cost (never a bill).
model ChatAiUsage {
  id               String   @id @default(uuid())
  day              DateTime @db.Date
  environment      String   @default("production")
  model            String
  source           String
  calls            Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  estCostUsd       Float    @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([day, environment, model, source])
}

model ChatErrorLog {
  id             String   @id @default(uuid())
  conversationId String?
  code           String
  source         String
  level          String   @default("error")
  details        Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model ChatRateBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ChatWebhookEvent {
  id             String   @id
  conversationId String
  messageId      String?
  completed      Boolean  @default(false)
  leaseOwner     String?
  leaseUntil     DateTime?
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([completed, createdAt])
}
