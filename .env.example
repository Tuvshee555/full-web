# Copy to .env.local and fill in. One file configures the storefront, the admin
# and the API (they all run in one process). Only variables the code reads are
# listed here.

# ---- Server ----
PORT=3000

# ---- Database (PostgreSQL) ----
# Local throwaway DB: run `npm run db:local` in another terminal.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/eyebrow?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/eyebrow?sslmode=disable"

# ---- Login tokens ----
# Use a long random string (48+ chars). Changing it logs everyone out.
JWT_SECRET=change-me

# ---- Public URLs (set to your real domain when you deploy) ----
# The frontends call the API on the same server under /api.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3000
CUSTOMER_URL=http://localhost:3000

# ---- Google login ----
# Add your site's origin under "Authorized JavaScript origins" for this client.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Facebook login ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# ---- QPay ----
# merchant.qpay.mn is LIVE (real money). Do not set QPAY_WEBHOOK_SECRET:
# QPay does not sign callbacks, and payments are verified with QPay directly.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ---- Images (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (SMTP, e.g. Brevo) ----
# SMTP_FROM / EMAIL_FROM must be a sender verified with your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=

# ---- Order alerts (Telegram) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
