# Copy to .env.local and fill in. One file now configures the storefront,
# the admin dashboard and the API, since they all run in one process.

# ---- Server ----
PORT=3000

# ---- Database (PostgreSQL) ----
# Local throwaway DB: run `npm run db:local` in another terminal.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/eyebrow?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/eyebrow?sslmode=disable"

# ---- Auth ----
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Public URLs ----
# The frontends call the API on the same server under /api.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_LEMON_VARIANT_ID=
# Used by the API for links/callbacks
BACKEND_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3000
CUSTOMER_URL=http://localhost:3000
# Optional; defaults to $FRONTEND_URL/admin (password-reset links)
ADMIN_URL=

# ---- Payments ----
STRIPE_ENABLED=false
# Must be non-empty even when STRIPE_ENABLED=false (the Stripe client is created at startup)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/mn/checkout/payment-pending
STRIPE_CANCEL_URL=http://localhost:3000/mn/checkout
PAYMENT_CURRENCY=
DELIVERY_FEE=
QPAY_BASE_URL=
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_WEBHOOK_SECRET=
LEMON_API_KEY=
LEMON_STORE_ID=
LEMON_TEST_MODE=true
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ---- Media / email / notifications / AI ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
GEN_MODEL=
