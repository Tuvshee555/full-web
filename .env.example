# Copy to .env.local and fill in. One file configures the storefront, the admin
# and the API (they all run in one process). Only variables the code reads are
# listed here.

# ---- Server ----
PORT=3000

# Lorentz chatbot (server only)
OPENAI_API_KEY=
# Default model for understanding and writing replies; the admin can override it per shop
# (Chat assistant → Settings → AI model). OPENAI_REPLY_MODEL / PRODUCT_UNDERSTANDING_MODEL
# override one side only. Spend is recorded per day and capped by the admin's daily budget.
OPENAI_MODEL=gpt-4.1
# Evaluation runs that spend model credit must be opted in (never against production):
#   EVAL_RUN_APPROVED=1 EVAL_MAX_MODEL_CALLS=150 npm run eval:chatbot:live

# ---- Meta: Messenger and Instagram (server only; never NEXT_PUBLIC_/VITE_) ----
# The webhook (/api/chatbot/webhook) answers 503 until the first four are set.
# Use credentials of the NEW Lorentz Meta app and Page only — never values from the
# old (compromised) Meta account. See docs/chatbot/META_SETUP.md.
# Meta App → Settings → Basic → App secret (signs every webhook delivery).
META_APP_SECRET=
# Any long random string; the same value goes into the App Dashboard webhook form.
META_VERIFY_TOKEN=
# The Lorentz Facebook Page id (numbers only). Events for any other Page are ignored.
META_PAGE_ID=
# A Page access token for that Page (pages_messaging; instagram_manage_messages for Instagram).
META_PAGE_ACCESS_TOKEN=
# Optional: the Instagram professional account linked to the Page (numbers only).
META_INSTAGRAM_ID=
# Optional: the Meta app id, so the bot's own echoes are recognised by app.
META_APP_ID=
META_GRAPH_VERSION=v23.0

# ---- Database (PostgreSQL) ----
# Local throwaway DB: run `npm run db:local` in another terminal.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/eyebrow?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/eyebrow?sslmode=disable"

# ---- Login tokens ----
# Use a long random string (48+ chars). Changing it logs everyone out.
JWT_SECRET=change-me

# ---- Public URLs (set to your real domain when you deploy) ----
# The frontends call the API on the same server under /api.
# Leave empty for same-origin /api (recommended, including previews).
# Only set a full URL when the API is hosted separately.
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3000
CUSTOMER_URL=http://localhost:3000
# Additional allowed frontend origins if the API is hosted separately, comma-separated.
CORS_ALLOWED_ORIGINS=
# Direct/local server: loopback. Set the actual hop count for your reverse proxy.
# Vercel defaults to one proxy hop automatically.
TRUST_PROXY=loopback
# Optional storefront delivery fee in MNT (default 9000).
DELIVERY_FEE=9000

# ---- Google login ----
# Add your site's origin under "Authorized JavaScript origins" for this client.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- QPay ----
# merchant.qpay.mn is LIVE (real money). Do not set QPAY_WEBHOOK_SECRET:
# QPay does not sign callbacks, and payments are verified with QPay directly.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ---- Images (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (SMTP, e.g. Brevo) ----
# SMTP_FROM / EMAIL_FROM must be a sender verified with your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=

# ---- Order alerts (Telegram) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduled cleanup of expired reservations (/api/jobs/expire-orders). Vercel Cron sends it as a bearer token; any other scheduler sends it in the same header. At least 16 characters.
CRON_SECRET=
